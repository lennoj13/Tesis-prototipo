# === Base de datos local ===
# URL de conexión a PostgreSQL. Reemplazar usuario, contraseña y nombre de la DB.
# Ejemplo: postgresql://postgres:12345@localhost:5432/matching_db
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/nombre_db

# === Clave JWT ===
# Llave secreta para firmar los tokens de sesión. Usa una cadena larga y segura.
JWT_SECRET_KEY=tu_clave_secreta_jwt_aqui

# === Credenciales de Correo (Notificaciones SMTP) ===
# Configuración para enviar correos (ej. alertas, cambio de clave). 
# Si usas Gmail, recuerda generar una "Contraseña de aplicación" (App Password).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo_del_sistema@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_aqui
