            }
          }
        }
      }
    },
      "/post": {
        "post": {
          "tags": ["WS Posts"],
          "summary": "Crear nueva publicación",
          "description": "Permite crear nuevas publicaciones",
          "operationId": "createPost",
          "produces": ["application/json"],
          "parameters": [
            {
              "in": "body",
              "name": "body",
              "description": "Datos de la nueva publicación",
              "required": true,
              "schema": {
                "$ref": "#/definitions/PostRequest"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Publicación creada exitosamente",
              "schema": {
                "$ref": "#/definitions/Response"
              }
            },
            "400": {
              "description": "Error en la solicitud",
              "schema": {
                "$ref": "#/definitions/ErrorResponse"
              }
            },
            "500": {
              "description": "Error interno del servidor",
              "schema": {
                "$ref": "#/definitions/ErrorResponse"
              }
            }
          }
        },
        "get": {
          "tags": ["WS Posts"],
          "summary": "Obtener todas las publicaciones",
          "description": "Obtiene todas las publicaciones disponibles.",
          "operationId": "getPosts",
          "produces": ["application/json"],
          "responses": {
            "200": {
              "description": "Lista de publicaciones obtenida exitosamente",
              "schema": {
                "$ref": "#/definitions/Response"
              }
            },
            "500": {
              "description": "Error interno del servidor",
              "schema": {
                "$ref": "#/definitions/ErrorResponse"
              }
            }
          }
        }
      },
      "/messages": {
        "post": {
          "tags": ["WS Messages"],
          "summary": "Enviar un mensaje",
          "description": "Envía un mensaje a otro usuario",
          "operationId": "sendMessage",
          "produces": ["application/json"],
          "parameters": [
            {
              "in": "body",
              "name": "body",
              "description": "Contenido del mensaje",
              "required": true,
              "schema": {
                "$ref": "#/definitions/MessageRequest"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Mensaje enviado exitosamente",
              "schema": {
                "$ref": "#/definitions/Response"
              }
            },
            "400": {
              "description": "Error en la solicitud",
              "schema": {
                "$ref": "#/definitions/ErrorResponse"
              }
            },
            "500": {
              "description": "Error interno del servidor",
              "schema": {
                "$ref": "#/definitions/ErrorResponse"
              }
            }
          }
        },
        "get": {
          "tags": ["WS Messages"],
          "summary": "Obtener conversaciones",
          "description": "Obtiene todas las conversaciones del usuario autenticado",
          "operationId": "getConversations",
          "produces": ["application/json"],
          "parameters": [
            {
              "in": "header",
              "name": "tokenapp",
              "description": "Token para autenticación",
              "required": true,
              "type": "string"
            }
          ],
          "responses": {
            "200": {
              "description": "Lista de conversaciones obtenida exitosamente",
              "schema": {
                "$ref": "#/definitions/Response"
              }
            },
            "500": {
              "description": "Error interno del servidor",
              "schema": {
                "$ref": "#/definitions/ErrorResponse"
              }
            }
          }
        },
      "put": {
        "tags": [
          "WS Messages"
        ],
        "summary": "Marcar mensajes como leídos",
        "description": "Permite marcar mensajes como leídos en una conversación",
        "operationId": "markAsRead",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "ID de la conversación y mensajes a marcar como leídos",
            "required": true,
            "schema": {
              "$ref": "#/definitions/MarkAsReadRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mensajes marcados como leídos exitosamente",
            "schema": {
              "$ref": "#/definitions/Response"
            }
          },
          "400": {
            "description": "Error en la solicitud",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/resources": {
      "post": {
        "tags": ["WS Resources"],
        "summary": "Crear un recurso académico",
        "description": "Permite crear un nuevo recurso académico",
        "operationId": "createResource",
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Datos del recurso a crear",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ResourceRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recurso creado exitosamente",
            "schema": {
              "$ref": "#/definitions/Response"
            }
          },
          "400": {
            "description": "Error en la solicitud",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      },
      "get": {
        "tags": ["WS Resources"],
        "summary": "Obtener todos los recursos",
        "description": "Retorna una lista de todos los recursos académicos disponibles.",
        "operationId": "getResources",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Lista de recursos obtenida exitosamente",
            "schema": {
              "$ref": "#/definitions/Response"
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
   "loginUserDef": {
     "type": "object",
     "properties": {
       "login_user": {
         "type": "string",
         "format": "string",
         "example": "admin"
       },
       "login_password": {
         "type": "string",
         "format": "string",
         "example": "admin"
       }
     }
    },
        "PostRequest": {
      "type": "object",
      "properties": {
        "post_content": {
          "type": "string",
          "example": "Este es el contenido de mi publicación."
        },
        "post_media": {
          "type": "string",
          "example": "http://example.com/imagen.jpg"
        },
        "post_author_id": {
          "type": "integer",
          "example": 1
        },
        "post_group_id": {
          "type": "integer",
          "example": 2
        }
      }
    },
    "MessageRequest": {
      "type": "object",
      "properties": {
        "sender_id": {
          "type": "integer",
          "example": 1
        },
        "receiver_id": {
          "type": "integer",
          "example": 2
        },
        "message_content": {
          "type": "string",
          "example": "Hola, ¿cómo estás?"
        }
      }
    },
    "MarkAsReadRequest": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "integer",
          "example": 1
        },
        "message_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "example": [1, 2, 3]
        }
      }
    },
        "ResourceRequest": {
      "type": "object",
      "properties": {
        "resource_title": {
          "type": "string",
          "example": "Clases de Vectores"
        },
        "resource_url": {
          "type": "string",
          "example": "http://example.com/clase_vectores.mp4"
        },
        "resource_description": {
          "type": "string",
          "example": "Clase de vectores unitarios y compuestos"
        },
        "uploader_id": {
          "type": "integer",
          "example": 1
        },
        "resource_academic_area": {
          "type": "string",
          "example": "Matemáticas"
        }
      }
    },
   "NotFound": {
      "type": "object",
      "properties": {
        "success": {
            "type": "boolean",
            "default": false
        },
        "message": {
            "type": "string",
            "example": "Recurso no encontrado"
        },
        "data": {
          "type": "string",
          "example": "{}"
        },
        "status": {
          "type": "string",
          "example": "404"
        }
      }
    },
   "ErrorResponse": {
      "type": "object",
      "properties": {
        "success": {
            "type": "boolean",
            "default": false
        },
        "message": {
            "type": "string"
        },
        "data": {
          "type": "string",
          "example": "{}"
        },
        "status": {
          "type": "string",
          "example": "500"
        }
      }
    },
   "Response": {
      "type": "object",
      "properties": {
        "success": {
            "type": "boolean",
            "default": false
        },
        "message": {
            "type": "string",
            "example": "ok"
        },
        "data": {
          "type": "string",
          "example": "{}"
        },
        "status": {
          "type": "string",
          "example": "200"
        }
      }
    }
  },
  "externalDocs": {
    "description": "Find out more about Swagger",
    "url": "http://swagger.io"
  }
}